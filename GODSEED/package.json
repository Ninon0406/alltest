{
  "name": "godseed",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "test": "vitest run tests/unit.test.ts tests/save.test.ts tests/combat.test.ts tests/balance.test.ts",
    "test:e2e": "playwright test",
    "generate:art": "node scripts/generate-art.mjs",
    "validate:content": "vitest run tests/content.test.ts",
    "test:all": "npm run typecheck && npm run lint && npm run validate:content && npm test && npm run build"
  },
  "dependencies": {
    "phaser": "4.2.1",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^24.19.2",
    "eslint": "^9.39.0",
    "fake-indexeddb": "^6.2.7",
    "pngjs": "^7.0.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  }
}
